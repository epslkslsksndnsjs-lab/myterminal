# MyTerminal environment variables
# Copy this file to .env and fill in the values.

# ── Subagent LLM provider (at least one required for subagent/fork skill) ──

# OpenAI (default provider)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Alibaba Cloud / DashScope (Qwen)
DASHSCOPE_API_KEY=sk-...
DASHSCOPE_MODEL=qwen-max

# ── Optional overrides ──

# Override the default LLM provider (openai|anthropic|deepseek|glm|qwen)
# MYTERMINAL_LLM_PROVIDER=openai

# Override the config directory (default: ~/.config/myterminal)
# MYTERMINAL_CONFIG_DIR=

# ── Workflows self-limit gates (defaults ARE the ceilings; only this local surface tunes them) ──
# Positive integers only; values above a hard ceiling run AT the ceiling.
# Endpoint config is NOT here — workflows share the subagent baseUrl / apiKey / model trio (single source).

# MYTERMINAL_WORKFLOW_TOKEN_CAP=8000000        # output tokens per run
# MYTERMINAL_WORKFLOW_UNLIMITED=0             # 1|true|yes|on drops the token cap only (user-authorized)
# MYTERMINAL_WORKFLOW_RUN_GATE_MINUTES=30      # wall clock per run
# MYTERMINAL_WORKFLOW_AGENT_CAP=1000           # hard ceiling 10000
# MYTERMINAL_WORKFLOW_CONCURRENCY=6            # max(2, min(16, cores-2)); hard ceiling 64
# MYTERMINAL_WORKFLOW_DISPATCH_WINDOW_MINUTES=10   # per-path; hard ceiling 100
# MYTERMINAL_WORKFLOW_DISPATCH_TURNS=50            # per-path; hard ceiling 500
# MYTERMINAL_WORKFLOW_STALL_SECONDS=180
# MYTERMINAL_WORKFLOW_WAIT_CHUNK_SECONDS=600
# MYTERMINAL_WORKFLOW_REDUCER_BUDGET_MINUTES=35    # must stay >= runGate + 5
# MYTERMINAL_WORKFLOW_REDUCER_TIMEOUT_MINUTES=40   # must stay >= reducerBudget + 5
# MYTERMINAL_WORKFLOW_KEEP_QUOTA_COUNT=50          # worktree retention quota
# MYTERMINAL_WORKFLOW_KEEP_QUOTA_BYTES=5368709120  # 5 GB
# MYTERMINAL_WORKFLOW_ARCHIVE_AFTER_DAYS=30
# MYTERMINAL_WORKFLOW_AUTO_ARCHIVE=0
# MYTERMINAL_WORKFLOW_SNAPSHOT_RETAIN=30
# MYTERMINAL_WORKFLOW_TERMINAL_RUN_RETAIN=10
# MYTERMINAL_WORKFLOW_REDUCER_QUOTA=3              # concurrent reducers
