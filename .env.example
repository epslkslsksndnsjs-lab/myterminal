# MyTerminal environment variables
# Copy this file to .env and fill in the values.

# ── Subagent LLM provider (at least one required for subagent/fork skill) ──

# OpenAI (default provider)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Alibaba Cloud / DashScope (Qwen)
DASHSCOPE_API_KEY=sk-...
DASHSCOPE_MODEL=qwen-max

# ── Optional overrides ──

# Override the default LLM provider (openai|anthropic|deepseek|glm|qwen)
# MYTERMINAL_LLM_PROVIDER=openai

# Override the config directory (default: ~/.config/myterminal)
# MYTERMINAL_CONFIG_DIR=
