        "replacements"
      ],
      "additionalProperties": false
    }
  },
  "blob_create": {
    "title": "Create local blob",
    "description": "Store UTF-8 or base64 content in a local content-addressed staging blob without changing workspace files or contacting external services.",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false,
      "idempotentHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "maxLength": 1400000
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "base64"
          ],
          "default": "utf-8"
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  },
